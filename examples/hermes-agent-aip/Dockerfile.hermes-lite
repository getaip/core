FROM postgres:17

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV HERMES_HOME=/opt/data
ENV HERMES_WRITE_SAFE_ROOT=/opt/data
ENV PATH="/opt/hermes/.venv/bin:${PATH}"

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gcc \
        g++ \
        git \
        libffi-dev \
        make \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        ripgrep \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -u 10000 -m -d /opt/data hermes \
    && mkdir -p /opt/data /opt/hermes \
    && chown -R hermes:hermes /opt/data

WORKDIR /opt/hermes

COPY . .

RUN python3 -m venv /opt/hermes/.venv \
    && /opt/hermes/.venv/bin/pip install --upgrade pip setuptools wheel \
    && /opt/hermes/.venv/bin/pip install --no-cache-dir -e ".[mcp]" "aiohttp==3.14.1"

VOLUME ["/opt/data"]

USER hermes
WORKDIR /opt/data

HEALTHCHECK --interval=5s --timeout=3s --retries=30 --start-period=20s \
    CMD curl -fsS "http://127.0.0.1:${API_SERVER_PORT:-8642}/health" || exit 1

ENTRYPOINT ["hermes"]
CMD ["gateway", "run", "--force"]
