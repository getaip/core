{
  "schema_version": "aip.private-sdk-release/v1",
  "registry": "getaip-private",
  "target_connector_repository": "getaip/aip-connectors",
  "minimum_verified_private_sdk_releases": 2,
  "workspace_version": "2.1.0",
  "publication_mode": "disabled_until_registry_bootstrap",
  "private_sdk_required_paths": [
    "Cargo.lock",
    "Cargo.toml",
    "LICENSE",
    "NOTICE",
    "README.md",
    "THIRD_PARTY_NOTICES",
    "clippy.toml",
    "deny.toml",
    "nextest.toml",
    "rust-toolchain.toml",
    "rustfmt.toml"
  ],
  "packages_in_publish_order": [
    "aip-core",
    "aip-profile-webhook",
    "aip-auth",
    "aip-crypto",
    "aip-profile-a2a",
    "aip-profile-mcp",
    "aip-schema",
    "aip-transport",
    "aip-discovery",
    "aip-mcp-session",
    "aip-transport-mcp-stdio",
    "aip-transport-mcp-streamable-http",
    "aip-transport-nats",
    "aip-transport-sse",
    "aip-connector-registry",
    "aip-transport-mcp-legacy-http-sse",
    "aip-runtime",
    "aip-connector",
    "aip-storage-postgres",
    "aip-gateway",
    "aip-mcp-client",
    "aip-connector-host",
    "aip-connector-host-bootstrap",
    "aip-conformance"
  ],
  "connector_repository_packages": [
    "aip-connector-cal-diy",
    "aip-host-cal-diy",
    "aip-connector-hermes-agent",
    "aip-host-hermes-agent",
    "aip-connector-chatwoot",
    "aip-host-chatwoot",
    "aip-connector-dify",
    "aip-host-dify",
    "aip-connector-crewai",
    "aip-host-crewai",
    "aip-connector-twenty",
    "aip-host-twenty"
  ],
  "connector_repository_required_paths": [
    ".dockerignore",
    ".editorconfig",
    ".gitleaks.toml",
    "Cargo.lock",
    "Cargo.toml",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES",
    "clippy.toml",
    "crates/aip-connector-crewai/sidecar/.dockerignore",
    "crates/aip-connector-crewai/sidecar/.gitignore",
    "crates/aip-connector-crewai/sidecar/Dockerfile",
    "crates/aip-connector-crewai/sidecar/Dockerfile.upstream",
    "crates/aip-connector-crewai/sidecar/aip_crewai_sidecar/__init__.py",
    "crates/aip-connector-crewai/sidecar/aip_crewai_sidecar/__main__.py",
    "crates/aip-connector-crewai/sidecar/aip_crewai_sidecar/app.py",
    "crates/aip-connector-crewai/sidecar/aip_crewai_sidecar/registry.py",
    "crates/aip-connector-crewai/sidecar/pyproject.toml",
    "crates/aip-connector-crewai/sidecar/qualification/registry.py",
    "crates/aip-connector-crewai/sidecar/tests/test_runtime.py",
    "crates/aip-connector-crewai/sidecar/uv.lock",
    "deny.toml",
    "deploy/connector-fleet/Dockerfile.host",
    "nextest.toml",
    "rust-toolchain.toml",
    "rustfmt.toml"
  ]
}
