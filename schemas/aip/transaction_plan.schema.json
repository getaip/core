{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TransactionPlan",
  "description": "Durable execution plan produced by a transactional `Plan` action.\n\nThe plan is protocol-visible evidence for a later `Commit`. It captures the\nexact action input hash, capability binding, relevant enterprise policy\nmetadata, and identity snapshot so runtimes can reject commits that no\nlonger match the planned operation.",
  "type": "object",
  "properties": {
    "plan_id": {
      "description": "Stable plan id referenced by commit requests.",
      "type": "string"
    },
    "transaction_id": {
      "description": "Stable transaction id for the plan.",
      "$ref": "#/$defs/TransactionId"
    },
    "action_id": {
      "description": "Action that created the plan.",
      "$ref": "#/$defs/ActionId"
    },
    "capability_id": {
      "description": "Capability the plan was produced for.",
      "$ref": "#/$defs/CapabilityId"
    },
    "transaction": {
      "description": "Planned transaction context.",
      "$ref": "#/$defs/ActionTransaction"
    },
    "planned_by": {
      "description": "Principal that requested the plan.",
      "$ref": "#/$defs/Principal"
    },
    "input_hash": {
      "description": "Canonical SHA-256 hash of the planned action input.",
      "type": "string"
    },
    "input_snapshot": {
      "description": "Optional redacted or raw input snapshot."
    },
    "predicted_side_effects": {
      "description": "Expected side effects declared by the capability contract.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SideEffect"
      }
    },
    "approval_required": {
      "description": "Whether committing the plan requires approval.",
      "type": "boolean"
    },
    "approval_policy": {
      "description": "Approval policy evaluated during planning.",
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "compensation": {
      "description": "Compensation contract available for the planned operation.",
      "anyOf": [
        {
          "$ref": "#/$defs/CompensationContract"
        },
        {
          "type": "null"
        }
      ]
    },
    "dry_run_fidelity": {
      "description": "Dry-run fidelity advertised by the capability.",
      "anyOf": [
        {
          "$ref": "#/$defs/DryRunFidelity"
        },
        {
          "type": "null"
        }
      ]
    },
    "identity": {
      "description": "Identity snapshot captured during planning.",
      "anyOf": [
        {
          "$ref": "#/$defs/IdentityContext"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "description": "Creation time.",
      "type": "string"
    },
    "expires_at": {
      "description": "Optional plan expiration.",
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "description": "Additional runtime metadata."
    }
  },
  "required": [
    "plan_id",
    "transaction_id",
    "action_id",
    "capability_id",
    "transaction",
    "planned_by",
    "input_hash",
    "approval_required",
    "created_at"
  ],
  "$defs": {
    "TransactionId": {
      "description": "Transactional action or saga identifier.",
      "type": "string"
    },
    "ActionId": {
      "description": "Action identifier.",
      "type": "string"
    },
    "CapabilityId": {
      "description": "Stable capability identifier.",
      "type": "string"
    },
    "ActionTransaction": {
      "description": "Transaction context for an action.",
      "type": "object",
      "properties": {
        "mode": {
          "description": "Transaction mode.",
          "$ref": "#/$defs/TransactionMode"
        },
        "transaction_id": {
          "description": "Stable transaction id.",
          "anyOf": [
            {
              "$ref": "#/$defs/TransactionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "plan_id": {
          "description": "Plan id produced by a previous planning action.",
          "type": [
            "string",
            "null"
          ]
        },
        "compensation_for": {
          "description": "Action being compensated.",
          "anyOf": [
            {
              "$ref": "#/$defs/ActionId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "TransactionMode": {
      "description": "Transactional action mode.",
      "oneOf": [
        {
          "description": "Execute the action normally.",
          "type": "string",
          "const": "execute"
        },
        {
          "description": "Validate without committing side effects.",
          "type": "string",
          "const": "dry_run"
        },
        {
          "description": "Produce a durable execution plan.",
          "type": "string",
          "const": "plan"
        },
        {
          "description": "Commit a previously planned operation.",
          "type": "string",
          "const": "commit"
        },
        {
          "description": "Execute a declared compensating operation.",
          "type": "string",
          "const": "compensate"
        },
        {
          "description": "Reconcile a provider operation whose commit outcome is unknown.",
          "type": "string",
          "const": "reconcile"
        },
        {
          "description": "Explicit state for operations that cannot roll back.",
          "type": "string",
          "const": "rollback_not_supported"
        }
      ]
    },
    "Principal": {
      "description": "Actor or authorizing entity in AIP.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable AIP principal id.",
          "$ref": "#/$defs/PrincipalId"
        },
        "kind": {
          "description": "Principal category.",
          "$ref": "#/$defs/PrincipalKind"
        },
        "display_name": {
          "description": "Human-readable display name.",
          "type": [
            "string",
            "null"
          ]
        },
        "trust_domain": {
          "description": "Trust domain that owns this principal.",
          "type": [
            "string",
            "null"
          ]
        },
        "did": {
          "description": "DID identity, if available.",
          "type": [
            "string",
            "null"
          ]
        },
        "external_refs": {
          "description": "Product-specific identities.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExternalRef"
          }
        },
        "delegated_authority": {
          "description": "Scoped delegated authority granted to this principal.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DelegatedAuthorityGrant"
          }
        },
        "auth_context": {
          "description": "Authentication metadata supplied by a profile or gateway."
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false
    },
    "PrincipalId": {
      "description": "Stable principal identifier.",
      "type": "string"
    },
    "PrincipalKind": {
      "description": "Entity category for a protocol principal.",
      "oneOf": [
        {
          "description": "A human user or operator.",
          "type": "string",
          "const": "human"
        },
        {
          "description": "An autonomous or semi-autonomous agent.",
          "type": "string",
          "const": "agent"
        },
        {
          "description": "A service account or machine identity.",
          "type": "string",
          "const": "service"
        },
        {
          "description": "A tenant/account boundary.",
          "type": "string",
          "const": "tenant"
        },
        {
          "description": "A customer identity.",
          "type": "string",
          "const": "customer"
        },
        {
          "description": "A contact identity in a channel product.",
          "type": "string",
          "const": "contact"
        },
        {
          "description": "A system-level actor.",
          "type": "string",
          "const": "system"
        }
      ]
    },
    "ExternalRef": {
      "description": "Product-specific identity reference preserved by connectors.",
      "type": "object",
      "properties": {
        "system": {
          "description": "Source system name, for example `chatwoot` or `dify`.",
          "type": "string"
        },
        "type": {
          "description": "Source-local entity type.",
          "type": "string"
        },
        "id": {
          "description": "Source-local entity id.",
          "type": "string"
        }
      },
      "required": [
        "system",
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "DelegatedAuthorityGrant": {
      "description": "Scoped authority delegated to this principal for another principal's work.\n\nDelegated authority is part of the native AIP identity model. It lets a\nruntime distinguish \"can read or operate on my own work\" from \"can read or\noperate on work owned by a specific principal\" without granting broad\n`*:any` scopes. Compatibility profiles may project this from their own\nauth systems, but the resulting grant is evaluated by AIP core/runtime\nsemantics.",
      "type": "object",
      "properties": {
        "principal_id": {
          "description": "Principal whose work is covered by the grant.",
          "$ref": "#/$defs/PrincipalId"
        },
        "scopes": {
          "description": "Granted scope labels. `*` grants all scopes for this principal.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expires_at": {
          "description": "Expiration timestamp. Expired grants MUST be ignored by runtimes.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Optional reason or authority reference retained for audit/debugging.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "principal_id"
      ],
      "additionalProperties": false
    },
    "SideEffect": {
      "description": "Side effect category for an enterprise capability.",
      "oneOf": [
        {
          "description": "Read data without intended mutation.",
          "type": "string",
          "const": "read"
        },
        {
          "description": "Mutate existing state or create new state.",
          "type": "string",
          "const": "write"
        },
        {
          "description": "Delete or destroy state.",
          "type": "string",
          "const": "delete"
        },
        {
          "description": "Send a user-visible or external message.",
          "type": "string",
          "const": "send_message"
        },
        {
          "description": "Move money, create financial obligations, or change billing state.",
          "type": "string",
          "const": "financial"
        },
        {
          "description": "Change identity, account, access, or credential state.",
          "type": "string",
          "const": "identity"
        },
        {
          "description": "Touch medical or health-related records.",
          "type": "string",
          "const": "medical"
        },
        {
          "description": "Touch legal, contractual, or compliance-sensitive records.",
          "type": "string",
          "const": "legal"
        },
        {
          "description": "Call an external network service.",
          "type": "string",
          "const": "external_network"
        },
        {
          "description": "Execute code or scripts supplied at runtime.",
          "type": "string",
          "const": "code_execution"
        }
      ]
    },
    "ApprovalPolicy": {
      "description": "Approval policy declared by a capability.",
      "type": "object",
      "properties": {
        "required": {
          "description": "Whether approval is required before execution.",
          "type": "boolean"
        },
        "reason": {
          "description": "Reason shown to an approver or audit trail.",
          "type": [
            "string",
            "null"
          ]
        },
        "approver_selector": {
          "description": "Approver selection rule.",
          "$ref": "#/$defs/ApproverSelector"
        },
        "ttl_ms": {
          "description": "Time-to-live for approval requests.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "evidence_requirements": {
          "description": "Required evidence.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRequirement"
          }
        },
        "delegated_authority": {
          "description": "Delegated approval authority.",
          "anyOf": [
            {
              "$ref": "#/$defs/DelegatedApprovalAuthority"
            },
            {
              "type": "null"
            }
          ]
        },
        "rule": {
          "description": "Composable authority expression. When absent, the legacy\n`approver_selector` is interpreted as one leaf predicate.",
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalRule"
            },
            {
              "type": "null"
            }
          ]
        },
        "minimum_distinct_principals": {
          "description": "Minimum number of distinct approving principals for the workflow.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1
        },
        "separation_of_duties": {
          "description": "Separation-of-duties requirements.",
          "$ref": "#/$defs/SeparationOfDuties",
          "default": {
            "requester_must_differ": false,
            "operator_must_differ": false,
            "allow_self_approval": false
          }
        },
        "policy_version": {
          "description": "Stable policy version retained in approval evidence.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "required",
        "approver_selector"
      ],
      "additionalProperties": false
    },
    "ApproverSelector": {
      "description": "Principal, role, group, policy, or external system that can approve work.",
      "oneOf": [
        {
          "description": "Specific approving principal.",
          "type": "object",
          "properties": {
            "id": {
              "description": "Principal id.",
              "$ref": "#/$defs/PrincipalId"
            },
            "type": {
              "type": "string",
              "const": "principal"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "description": "Role name.",
          "type": "object",
          "properties": {
            "name": {
              "description": "Role identifier.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "role"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "description": "Group name.",
          "type": "object",
          "properties": {
            "name": {
              "description": "Group identifier.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "group"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "description": "Tenant-owned approval policy.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "tenant_policy"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "description": "External approval system.",
          "type": "object",
          "properties": {
            "system": {
              "description": "External system identifier.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "external_system"
            }
          },
          "required": [
            "type",
            "system"
          ],
          "additionalProperties": false
        }
      ]
    },
    "EvidenceRequirement": {
      "description": "Evidence required before approval can be decided.",
      "oneOf": [
        {
          "description": "Human-readable reason.",
          "type": "string",
          "const": "reason"
        },
        {
          "description": "Snapshot of the action input.",
          "type": "string",
          "const": "input_snapshot"
        },
        {
          "description": "Policy engine decision.",
          "type": "string",
          "const": "policy_decision"
        },
        {
          "description": "External ticket or case.",
          "type": "string",
          "const": "external_ticket"
        },
        {
          "description": "Attachment or artifact.",
          "type": "string",
          "const": "attachment"
        }
      ]
    },
    "DelegatedApprovalAuthority": {
      "description": "Delegated approval authority.",
      "type": "object",
      "properties": {
        "principal": {
          "description": "Principal receiving delegated approval authority.",
          "$ref": "#/$defs/PrincipalId"
        },
        "scope": {
          "description": "Delegated scope labels.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expires_at": {
          "description": "Expiration timestamp.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "principal"
      ],
      "additionalProperties": false
    },
    "ApprovalRule": {
      "description": "Composable approval authority expression.\n\nLeaf predicates are evaluated only against authority memberships returned\nby a trusted resolver. Values carried in an action or decision payload are\nnever sufficient to satisfy a predicate.",
      "oneOf": [
        {
          "description": "Every child expression must be satisfied.",
          "type": "object",
          "properties": {
            "rules": {
              "description": "Child expressions.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/ApprovalRule"
              }
            },
            "allow_decision_reuse": {
              "description": "Explicitly permits one verified decision to satisfy more than one child.",
              "type": "boolean",
              "default": false
            },
            "operator": {
              "type": "string",
              "const": "all"
            }
          },
          "required": [
            "operator",
            "rules"
          ],
          "additionalProperties": false
        },
        {
          "description": "At least one child expression must be satisfied.",
          "type": "object",
          "properties": {
            "rules": {
              "description": "Child expressions.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/ApprovalRule"
              }
            },
            "operator": {
              "type": "string",
              "const": "any"
            }
          },
          "required": [
            "operator",
            "rules"
          ],
          "additionalProperties": false
        },
        {
          "description": "At least `required` distinct matching decisions must be present.",
          "type": "object",
          "properties": {
            "required": {
              "description": "Required number of decisions.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "rules": {
              "description": "Expressions that can contribute to the quorum.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/ApprovalRule"
              }
            },
            "distinct_principals": {
              "description": "Whether one principal may contribute at most one vote.",
              "type": "boolean",
              "default": true
            },
            "operator": {
              "type": "string",
              "const": "quorum"
            }
          },
          "required": [
            "operator",
            "required",
            "rules"
          ],
          "additionalProperties": false
        },
        {
          "description": "A specific principal must approve.",
          "type": "object",
          "properties": {
            "id": {
              "description": "Required principal id.",
              "$ref": "#/$defs/PrincipalId"
            },
            "operator": {
              "type": "string",
              "const": "principal"
            }
          },
          "required": [
            "operator",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "description": "A member of a trusted role must approve.",
          "type": "object",
          "properties": {
            "name": {
              "description": "Required role name.",
              "type": "string"
            },
            "operator": {
              "type": "string",
              "const": "role"
            }
          },
          "required": [
            "operator",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "description": "A member of a trusted group must approve.",
          "type": "object",
          "properties": {
            "name": {
              "description": "Required group name.",
              "type": "string"
            },
            "operator": {
              "type": "string",
              "const": "group"
            }
          },
          "required": [
            "operator",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "description": "A member authorized by a tenant policy must approve.",
          "type": "object",
          "properties": {
            "policy_id": {
              "description": "Stable tenant policy id.",
              "type": "string"
            },
            "operator": {
              "type": "string",
              "const": "tenant_policy"
            }
          },
          "required": [
            "operator",
            "policy_id"
          ],
          "additionalProperties": false
        },
        {
          "description": "A verified external approval system must approve.",
          "type": "object",
          "properties": {
            "system": {
              "description": "External system id.",
              "type": "string"
            },
            "operator": {
              "type": "string",
              "const": "external_system"
            }
          },
          "required": [
            "operator",
            "system"
          ],
          "additionalProperties": false
        },
        {
          "description": "A non-revoked delegated authority grant must match the operation.",
          "type": "object",
          "properties": {
            "scope": {
              "description": "Required delegated scope.",
              "type": "string"
            },
            "max_risk": {
              "description": "Maximum accepted risk for this grant.",
              "anyOf": [
                {
                  "$ref": "#/$defs/RiskLevel"
                },
                {
                  "type": "null"
                }
              ]
            },
            "max_value": {
              "description": "Maximum governed numeric value for this grant.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "operator": {
              "type": "string",
              "const": "delegated_authority"
            }
          },
          "required": [
            "operator",
            "scope"
          ],
          "additionalProperties": false
        }
      ]
    },
    "RiskLevel": {
      "description": "Operational risk classification.",
      "oneOf": [
        {
          "description": "Low-risk capability.",
          "type": "string",
          "const": "low"
        },
        {
          "description": "Medium-risk capability.",
          "type": "string",
          "const": "medium"
        },
        {
          "description": "High-risk capability.",
          "type": "string",
          "const": "high"
        },
        {
          "description": "Critical-risk capability.",
          "type": "string",
          "const": "critical"
        }
      ]
    },
    "SeparationOfDuties": {
      "description": "Separation-of-duties requirements for an approval workflow.",
      "type": "object",
      "properties": {
        "requester_must_differ": {
          "description": "The requester cannot approve the request.",
          "type": "boolean",
          "default": false
        },
        "operator_must_differ": {
          "description": "The action operator cannot approve the request.",
          "type": "boolean",
          "default": false
        },
        "allow_self_approval": {
          "description": "Explicitly permits self-approval when no stricter rule prohibits it.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "CompensationContract": {
      "description": "Compensation behavior declared by a capability.",
      "type": "object",
      "properties": {
        "mode": {
          "description": "Compensation mode.",
          "$ref": "#/$defs/CompensationMode"
        },
        "compensation_capability_id": {
          "description": "Capability used to compensate this operation, when available.",
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilityId"
            },
            {
              "type": "null"
            }
          ]
        },
        "compensation_window_ms": {
          "description": "Maximum window for compensation.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "requires_approval": {
          "description": "Whether compensation itself requires approval.",
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "requires_approval"
      ],
      "additionalProperties": false
    },
    "CompensationMode": {
      "description": "Compensation support declared by a capability.",
      "oneOf": [
        {
          "description": "No compensation is required for successful execution.",
          "type": "string",
          "const": "not_required"
        },
        {
          "description": "A compensating capability is supported.",
          "type": "string",
          "const": "supported"
        },
        {
          "description": "Compensation is attempted but cannot be guaranteed.",
          "type": "string",
          "const": "best_effort"
        },
        {
          "description": "Rollback or compensation is not supported.",
          "type": "string",
          "const": "rollback_not_supported"
        }
