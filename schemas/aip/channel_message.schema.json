{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChannelMessage",
  "description": "External channel message.",
  "type": "object",
  "properties": {
    "conversation": {
      "description": "Conversation/thread.",
      "$ref": "#/$defs/Conversation"
    },
    "identity": {
      "description": "Identity context used by policy, audit, and credential mapping.",
      "anyOf": [
        {
          "$ref": "#/$defs/IdentityContext"
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "description": "Message metadata."
    },
    "sender": {
      "description": "Sender.",
      "$ref": "#/$defs/Principal"
    },
    "parts": {
      "description": "Message parts.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/MessagePart"
      }
    },
    "delivery": {
      "description": "Delivery/idempotency metadata."
    },
    "raw_payload": {
      "description": "Original product payload."
    }
  },
  "required": [
    "conversation",
    "message",
    "sender",
    "parts"
  ],
  "$defs": {
    "Conversation": {
      "description": "Customer or user-facing conversation thread.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable AIP conversation id.",
          "$ref": "#/$defs/ConversationId"
        },
        "channel": {
          "description": "Channel metadata."
        },
        "status": {
          "description": "Conversation status.",
          "$ref": "#/$defs/ConversationStatus"
        },
        "external_refs": {
          "description": "Product-specific ids.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExternalRef"
          }
        },
        "contact": {
          "description": "Customer/contact principal.",
          "anyOf": [
            {
              "$ref": "#/$defs/Principal"
            },
            {
              "type": "null"
            }
          ]
        },
        "assignee": {
          "description": "Human or bot assignee.",
          "anyOf": [
            {
              "$ref": "#/$defs/Principal"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "description": "Priority.",
          "anyOf": [
            {
              "$ref": "#/$defs/Priority"
            },
            {
              "type": "null"
            }
          ]
        },
        "labels": {
          "description": "Labels/tags.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "description": "Extension metadata."
        }
      },
      "required": [
        "id",
        "channel",
        "status"
      ],
      "additionalProperties": false
    },
    "ConversationId": {
      "description": "Conversation identifier.",
      "type": "string"
    },
    "ConversationStatus": {
      "description": "Conversation state in a user-facing channel.",
      "oneOf": [
        {
          "description": "Conversation is open.",
          "type": "string",
          "const": "open"
        },
        {
          "description": "Conversation is pending.",
          "type": "string",
          "const": "pending"
        },
        {
          "description": "Conversation is resolved.",
          "type": "string",
          "const": "resolved"
        },
        {
          "description": "Conversation is snoozed.",
          "type": "string",
          "const": "snoozed"
        },
        {
          "description": "Conversation is archived.",
          "type": "string",
          "const": "archived"
        }
      ]
    },
    "ExternalRef": {
      "description": "Product-specific identity reference preserved by connectors.",
      "type": "object",
      "properties": {
        "system": {
          "description": "Source system name, for example `chatwoot` or `dify`.",
          "type": "string"
        },
        "type": {
          "description": "Source-local entity type.",
          "type": "string"
        },
        "id": {
          "description": "Source-local entity id.",
          "type": "string"
        }
      },
      "required": [
        "system",
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "Principal": {
      "description": "Actor or authorizing entity in AIP.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable AIP principal id.",
          "$ref": "#/$defs/PrincipalId"
        },
        "kind": {
          "description": "Principal category.",
          "$ref": "#/$defs/PrincipalKind"
        },
        "display_name": {
          "description": "Human-readable display name.",
          "type": [
            "string",
            "null"
          ]
        },
        "trust_domain": {
          "description": "Trust domain that owns this principal.",
          "type": [
            "string",
            "null"
          ]
        },
        "did": {
          "description": "DID identity, if available.",
          "type": [
            "string",
            "null"
          ]
        },
        "external_refs": {
          "description": "Product-specific identities.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExternalRef"
          }
        },
        "delegated_authority": {
          "description": "Scoped delegated authority granted to this principal.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DelegatedAuthorityGrant"
          }
        },
        "auth_context": {
          "description": "Authentication metadata supplied by a profile or gateway."
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false
    },
    "PrincipalId": {
      "description": "Stable principal identifier.",
      "type": "string"
    },
    "PrincipalKind": {
      "description": "Entity category for a protocol principal.",
      "oneOf": [
        {
          "description": "A human user or operator.",
          "type": "string",
          "const": "human"
        },
        {
          "description": "An autonomous or semi-autonomous agent.",
          "type": "string",
          "const": "agent"
        },
        {
          "description": "A service account or machine identity.",
          "type": "string",
          "const": "service"
        },
        {
          "description": "A tenant/account boundary.",
          "type": "string",
          "const": "tenant"
        },
        {
          "description": "A customer identity.",
          "type": "string",
          "const": "customer"
        },
        {
          "description": "A contact identity in a channel product.",
          "type": "string",
          "const": "contact"
        },
        {
          "description": "A system-level actor.",
          "type": "string",
          "const": "system"
        }
      ]
    },
    "DelegatedAuthorityGrant": {
      "description": "Scoped authority delegated to this principal for another principal's work.\n\nDelegated authority is part of the native AIP identity model. It lets a\nruntime distinguish \"can read or operate on my own work\" from \"can read or\noperate on work owned by a specific principal\" without granting broad\n`*:any` scopes. Compatibility profiles may project this from their own\nauth systems, but the resulting grant is evaluated by AIP core/runtime\nsemantics.",
      "type": "object",
      "properties": {
        "principal_id": {
          "description": "Principal whose work is covered by the grant.",
          "$ref": "#/$defs/PrincipalId"
        },
        "scopes": {
          "description": "Granted scope labels. `*` grants all scopes for this principal.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expires_at": {
          "description": "Expiration timestamp. Expired grants MUST be ignored by runtimes.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Optional reason or authority reference retained for audit/debugging.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "principal_id"
      ],
      "additionalProperties": false
    },
    "Priority": {
      "description": "Conversation priority.",
      "oneOf": [
        {
          "description": "Low priority.",
          "type": "string",
          "const": "low"
        },
        {
          "description": "Medium priority.",
          "type": "string",
          "const": "medium"
        },
        {
          "description": "High priority.",
          "type": "string",
          "const": "high"
        },
        {
          "description": "Urgent priority.",
          "type": "string",
          "const": "urgent"
        }
      ]
    },
    "IdentityContext": {
      "description": "Identity, tenant, and credential mapping context for enterprise actions.",
      "type": "object",
      "properties": {
        "tenant": {
          "description": "Tenant boundary.",
          "anyOf": [
            {
              "$ref": "#/$defs/TenantRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "external_account": {
          "description": "External account boundary.",
          "anyOf": [
            {
              "$ref": "#/$defs/ExternalAccountRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "external_user": {
          "description": "External user associated with the invocation.",
          "anyOf": [
            {
              "$ref": "#/$defs/ExternalUserRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "human_actor": {
          "description": "Human actor that initiated or owns the work.",
          "anyOf": [
            {
              "$ref": "#/$defs/Principal"
            },
            {
              "type": "null"
            }
          ]
        },
        "service_account": {
          "description": "Service account executing the operation.",
          "anyOf": [
            {
              "$ref": "#/$defs/Principal"
            },
            {
              "type": "null"
            }
          ]
        },
        "acted_on_behalf_of": {
          "description": "Principal on whose behalf the operation is performed.",
          "anyOf": [
            {
              "$ref": "#/$defs/Principal"
            },
            {
              "type": "null"
            }
          ]
        },
        "credential_ref": {
          "description": "Reference to external credential material.",
          "anyOf": [
            {
              "$ref": "#/$defs/CredentialRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "oauth": {
          "description": "OAuth lifecycle state without token material.",
          "anyOf": [
            {
              "$ref": "#/$defs/OAuthCredentialState"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "TenantRef": {
      "description": "Tenant reference used for policy and credential partitioning.",
      "type": "object",
      "properties": {
        "id": {
          "description": "AIP or external tenant id.",
          "type": "string"
        },
        "system": {
          "description": "Source system that owns the tenant id.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "ExternalAccountRef": {
      "description": "External account reference used by product connectors.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Account id in the source system.",
          "type": "string"
        },
        "system": {
          "description": "Source system name.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "system"
      ],
      "additionalProperties": false
    },
    "ExternalUserRef": {
      "description": "External user reference used by product connectors.",
      "type": "object",
      "properties": {
        "id": {
          "description": "User id in the source system.",
          "type": "string"
        },
        "system": {
          "description": "Source system name.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "system"
      ],
      "additionalProperties": false
    },
    "CredentialRef": {
      "description": "Reference to credential material stored outside protocol envelopes.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Credential id or vault reference.",
          "type": "string"
        },
        "issuer": {
          "description": "Credential issuer or storage boundary.",
          "type": "string"
        },
        "scopes": {
          "description": "Granted scope labels known to the runtime.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "issuer"
      ],
      "additionalProperties": false
    },
    "OAuthCredentialState": {
      "description": "OAuth credential lifecycle state without raw token material.",
      "type": "object",
      "properties": {
        "issuer": {
          "description": "Authorization server or provider id.",
          "type": "string"
        },
        "client_id": {
          "description": "OAuth client id or service identifier.",
          "type": [
            "string",
            "null"
          ]
        },
        "scopes": {
          "description": "Granted scope labels.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expires_at": {
          "description": "Token expiration timestamp, when known.",
          "type": [
            "string",
            "null"
          ]
        },
        "refresh_available": {
          "description": "Whether refresh is available without human reauthorization.",
          "type": "boolean"
        }
      },
      "required": [
        "issuer",
        "refresh_available"
      ],
      "additionalProperties": false
    },
    "MessagePart": {
      "description": "Rich content part carried by a message, result, or channel event.",
      "oneOf": [
        {
          "description": "Text content.",
          "type": "object",
          "properties": {
            "text": {
              "description": "Text body.",
              "type": "string"
            },
            "format": {
              "description": "Optional text format, for example `plain` or `markdown`.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "description": "Image content.",
          "type": "object",
          "properties": {
            "url": {
              "description": "Remote URL.",
              "type": [
                "string",
                "null"
              ]
            },
            "data": {
              "description": "Inline data.",
              "type": [
                "string",
                "null"
              ]
            },
            "mime_type": {
              "description": "MIME type.",
              "type": "string"
            },
            "alt": {
              "description": "Accessibility alt text.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "image"
            }
          },
          "required": [
            "type",
            "mime_type"
          ],
          "additionalProperties": false
        },
        {
          "description": "File content.",
          "type": "object",
          "properties": {
            "url": {
              "description": "Remote URL.",
              "type": [
                "string",
                "null"
              ]
            },
            "data": {
              "description": "Inline data.",
              "type": [
                "string",
                "null"
              ]
            },
            "mime_type": {
              "description": "MIME type.",
              "type": "string"
            },
            "filename": {
              "description": "File name.",
              "type": "string"
            },
            "size_bytes": {
              "description": "File size in bytes.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "file"
            }
          },
          "required": [
            "type",
            "mime_type",
            "filename"
          ],
          "additionalProperties": false
        },
        {
          "description": "Audio content.",
          "type": "object",
          "properties": {
            "url": {
              "description": "Remote URL.",
              "type": [
                "string",
                "null"
              ]
            },
            "data": {
              "description": "Inline data.",
              "type": [
                "string",
                "null"
              ]
            },
            "mime_type": {
              "description": "MIME type.",
              "type": "string"
            },
            "transcript": {
              "description": "Optional transcript.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "audio"
            }
          },
          "required": [
            "type",
            "mime_type"
          ],
          "additionalProperties": false
        },
        {
          "description": "Interactive form.",
          "type": "object",
          "properties": {
            "fields": {
              "description": "Form fields.",
              "type": "array",
              "items": true
            },
            "actions": {
              "description": "Form actions.",
              "type": "array",
              "items": true
            },
            "type": {
              "type": "string",
              "const": "form"
            }
          },
          "required": [
            "type",
            "fields",
            "actions"
          ],
          "additionalProperties": false
        },
        {
          "description": "Rich card.",
          "type": "object",
          "properties": {
            "title": {
              "description": "Card title.",
              "type": "string"
            },
            "body": {
              "description": "Card body.",
              "type": "string"
            },
            "actions": {
              "description": "Card actions.",
              "type": "array",
              "items": true
            },
            "media": {
              "description": "Card media."
            },
            "type": {
              "type": "string",
              "const": "card"
            }
          },
          "required": [
            "type",
            "title",
            "body"
          ],
          "additionalProperties": false
        },
        {
          "description": "Structured JSON payload.",
          "type": "object",
          "properties": {
            "data": {
              "description": "JSON data."
            },
            "schema": {
              "description": "Optional JSON Schema."
            },
            "type": {
              "type": "string",
              "const": "json"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "description": "Tool result payload.",
          "type": "object",
          "properties": {
            "tool_call_id": {
              "description": "Tool call id.",
              "type": "string"
            },
            "data": {
              "description": "Result data."
            },
            "error": {
              "description": "Error data."
            },
            "type": {
              "type": "string",
              "const": "tool_result"
            }
          },
          "required": [
            "type",
            "tool_call_id"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$id": "https://getaip.org/schemas/aip/channel_message.schema.json",
  "additionalProperties": false
}