{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StreamChunk",
  "description": "Partial output, progress, tool event, or terminal stream marker.",
  "type": "object",
  "properties": {
    "action_id": {
      "description": "Source action.",
      "$ref": "#/$defs/ActionId"
    },
    "sequence": {
      "description": "Monotonic chunk sequence.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "kind": {
      "description": "Chunk kind.",
      "$ref": "#/$defs/StreamChunkKind"
    },
    "data": {
      "description": "Structured chunk data."
    },
    "part": {
      "description": "Optional rich message part.",
      "anyOf": [
        {
          "$ref": "#/$defs/MessagePart"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "action_id",
    "sequence",
    "kind"
  ],
  "$defs": {
    "ActionId": {
      "description": "Action identifier.",
      "type": "string"
    },
    "StreamChunkKind": {
      "description": "Stream chunk kind.",
      "oneOf": [
        {
          "description": "Partial user-visible output.",
          "type": "string",
          "const": "data"
        },
        {
          "description": "Progress update.",
          "type": "string",
          "const": "progress"
        },
        {
          "description": "Tool call update.",
          "type": "string",
          "const": "tool"
        },
        {
          "description": "Optional reasoning/progress event.",
          "type": "string",
          "const": "thought"
        },
        {
          "description": "Preview artifact.",
          "type": "string",
          "const": "preview"
        },
        {
          "description": "Human approval is pending.",
          "type": "string",
          "const": "pending_approval"
        },
        {
          "description": "Stream-level error.",
          "type": "string",
          "const": "error"
        },
        {
          "description": "Stream completed.",
          "type": "string",
          "const": "done"
        }
      ]
    },
    "MessagePart": {
      "description": "Rich content part carried by a message, result, or channel event.",
      "oneOf": [
        {
          "description": "Text content.",
          "type": "object",
          "properties": {
            "text": {
              "description": "Text body.",
              "type": "string"
            },
            "format": {
              "description": "Optional text format, for example `plain` or `markdown`.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "description": "Image content.",
          "type": "object",
          "properties": {
            "url": {
              "description": "Remote URL.",
              "type": [
                "string",
                "null"
              ]
            },
            "data": {
              "description": "Inline data.",
              "type": [
                "string",
                "null"
              ]
            },
            "mime_type": {
              "description": "MIME type.",
              "type": "string"
            },
            "alt": {
              "description": "Accessibility alt text.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "image"
            }
          },
          "required": [
            "type",
            "mime_type"
          ],
          "additionalProperties": false
        },
        {
          "description": "File content.",
          "type": "object",
          "properties": {
            "url": {
              "description": "Remote URL.",
              "type": [
                "string",
                "null"
              ]
            },
            "data": {
              "description": "Inline data.",
              "type": [
                "string",
                "null"
              ]
            },
            "mime_type": {
              "description": "MIME type.",
              "type": "string"
            },
            "filename": {
              "description": "File name.",
              "type": "string"
            },
            "size_bytes": {
              "description": "File size in bytes.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "file"
            }
          },
          "required": [
            "type",
            "mime_type",
            "filename"
          ],
          "additionalProperties": false
        },
        {
          "description": "Audio content.",
          "type": "object",
          "properties": {
            "url": {
              "description": "Remote URL.",
              "type": [
                "string",
                "null"
              ]
            },
            "data": {
              "description": "Inline data.",
              "type": [
                "string",
                "null"
              ]
            },
            "mime_type": {
              "description": "MIME type.",
              "type": "string"
            },
            "transcript": {
              "description": "Optional transcript.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "audio"
            }
          },
          "required": [
            "type",
            "mime_type"
          ],
          "additionalProperties": false
        },
        {
          "description": "Interactive form.",
          "type": "object",
          "properties": {
            "fields": {
              "description": "Form fields.",
              "type": "array",
              "items": true
            },
            "actions": {
              "description": "Form actions.",
              "type": "array",
              "items": true
            },
            "type": {
              "type": "string",
              "const": "form"
            }
          },
          "required": [
            "type",
            "fields",
            "actions"
          ],
          "additionalProperties": false
        },
        {
          "description": "Rich card.",
          "type": "object",
          "properties": {
            "title": {
              "description": "Card title.",
              "type": "string"
            },
            "body": {
              "description": "Card body.",
              "type": "string"
            },
            "actions": {
              "description": "Card actions.",
              "type": "array",
              "items": true
            },
            "media": {
              "description": "Card media."
            },
            "type": {
              "type": "string",
              "const": "card"
            }
          },
          "required": [
            "type",
            "title",
            "body"
          ],
          "additionalProperties": false
        },
        {
          "description": "Structured JSON payload.",
          "type": "object",
          "properties": {
            "data": {
              "description": "JSON data."
            },
            "schema": {
              "description": "Optional JSON Schema."
            },
            "type": {
              "type": "string",
              "const": "json"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "description": "Tool result payload.",
          "type": "object",
          "properties": {
            "tool_call_id": {
              "description": "Tool call id.",
              "type": "string"
            },
            "data": {
              "description": "Result data."
            },
            "error": {
              "description": "Error data."
            },
            "type": {
              "type": "string",
              "const": "tool_result"
            }
          },
          "required": [
            "type",
            "tool_call_id"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$id": "https://getaip.org/schemas/aip/stream_chunk.schema.json",
  "additionalProperties": false
}