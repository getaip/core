        }
      },
      "required": [
        "requires_plan_before_commit",
        "dry_run_fidelity"
      ],
      "additionalProperties": false
    },
    "TransactionMode": {
      "description": "Transactional action mode.",
      "oneOf": [
        {
          "description": "Execute the action normally.",
          "type": "string",
          "const": "execute"
        },
        {
          "description": "Validate without committing side effects.",
          "type": "string",
          "const": "dry_run"
        },
        {
          "description": "Produce a durable execution plan.",
          "type": "string",
          "const": "plan"
        },
        {
          "description": "Commit a previously planned operation.",
          "type": "string",
          "const": "commit"
        },
        {
          "description": "Execute a declared compensating operation.",
          "type": "string",
          "const": "compensate"
        },
        {
          "description": "Reconcile a provider operation whose commit outcome is unknown.",
          "type": "string",
          "const": "reconcile"
        },
        {
          "description": "Explicit state for operations that cannot roll back.",
          "type": "string",
          "const": "rollback_not_supported"
        }
      ]
    },
    "DryRunFidelity": {
      "description": "Dry-run fidelity declared by a capability.",
