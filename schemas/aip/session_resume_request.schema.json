{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionResumeRequest",
  "description": "Request to resume one session after reconnect.",
  "type": "object",
  "properties": {
    "session_id": {
      "description": "Session to resume.",
      "$ref": "#/$defs/SessionId"
    },
    "resume_token": {
      "description": "Optional bearer or opaque resume token.",
      "type": [
        "string",
        "null"
      ]
    },
    "last_event_cursor": {
      "description": "Last event cursor observed by the client.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "session_id"
  ],
  "$defs": {
    "SessionId": {
      "description": "Session identifier.",
      "type": "string"
    }
  },
  "$id": "https://getaip.org/schemas/aip/session_resume_request.schema.json",
  "additionalProperties": false
}